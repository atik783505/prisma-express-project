generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  active
  inactive
  suspended
}

enum Role {
  user
  admin
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  firstName String
  lastName  String
  status    AccountStatus @default(active)

  email    String @unique
  password String
  phone    String @unique
  role     Role   @default(user)

  designation      String?
  emailVerfication Boolean @default(false)

  bookings Booking[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EventStatus {
  draft
  published
}

model Event {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name             String
  shortDescription String

  startTime DateTime?
  endTime   DateTime?

  description String?
  status      EventStatus @default(draft)

  location String?
  price    Int?
  seat     Int?
  banner   String?

  guests   Guest[]
  bookings Booking[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name             String
  designation      String
  company          String
  shortDescription String

  event   Event  @relation(fields: [eventId], references: [id])
  eventId String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  pending
  booked
  cancelled
}

model Booking {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  event   Event  @relation(fields: [eventId], references: [id])
  eventId String @db.ObjectId

  user   User   @relation(fields: [userId], references: [id])
  userId String @db.ObjectId

  payment Payment?
  status  BookingStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentStatus {
  pending
  paid
  rejected
}

model Payment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  event   Event  @relation(fields: [eventId], references: [id])
  eventId String @db.ObjectId

  user   User   @relation(fields: [userId], references: [id])
  userId String @db.ObjectId

  booking   Booking @relation(fields: [bookingId], references: [id])
  bookingId String  @unique @db.ObjectId

  cupon   Cupon?  @relation(fields: [cuponId], references: [id])
  cuponId String? @db.ObjectId

  price         Int
  paymentStatus PaymentStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cupon {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  code     String    @unique
  discount Int
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}